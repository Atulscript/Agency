rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow read, write: if request.auth != null;
      
      match /tickets/{ticketId} {
        allow read, write: if request.auth != null;
      }
      match /invoices/{invoiceId} {
        allow read, write: if request.auth != null;
      }
      match /chat_messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
